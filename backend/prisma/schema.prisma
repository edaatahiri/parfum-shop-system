generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auditlogs {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  action     String
  table_name String
  record_id  Int?
  old_value  String?  @db.Text
  new_value  String?  @db.Text
  ip_address String?
  created_at DateTime @default(now())
  users      users?   @relation(fields: [user_id], references: [id], map: "AuditLogs_user_id_fkey")

  @@index([user_id], map: "AuditLogs_user_id_fkey")
}

model detajet_porosise_furnitorit {
  detal_id             Int                  @id @default(autoincrement())
  porosi_id            Int
  parfum_id            Int
  sasia                Int
  cmimi_njesi          Float
  cmimi_total          Float
  parfum               parfum               @relation(fields: [parfum_id], references: [parfum_id], map: "Detajet_Porosise_Furnitorit_parfum_id_fkey")
  porosite_furnitoreve porosite_furnitoreve @relation(fields: [porosi_id], references: [porosi_id], map: "Detajet_Porosise_Furnitorit_porosi_id_fkey")

  @@index([parfum_id], map: "Detajet_Porosise_Furnitorit_parfum_id_fkey")
  @@index([porosi_id], map: "Detajet_Porosise_Furnitorit_porosi_id_fkey")
}

model detajet_shitjes {
  detal_id    Int     @id @default(autoincrement())
  shitje_id   Int
  parfum_id   Int
  sasia       Int
  cmimi_njesi Float
  cmimi_total Float
  parfum      parfum  @relation(fields: [parfum_id], references: [parfum_id], map: "Detajet_Shitjes_parfum_id_fkey")
  shitjet     shitjet @relation(fields: [shitje_id], references: [shitje_id], map: "Detajet_Shitjes_shitje_id_fkey")

  @@index([parfum_id], map: "Detajet_Shitjes_parfum_id_fkey")
  @@index([shitje_id], map: "Detajet_Shitjes_shitje_id_fkey")
}

model furnitoret {
  furnitor_id          Int                    @id @default(autoincrement())
  emri                 String
  personi_kontaktit    String
  telefoni             String
  email                String
  adresa               String
  shteti               String
  porosite_furnitoreve porosite_furnitoreve[]
}

model kategoria {
  emri        String   @unique(map: "Kategoria_emri_key")
  kategori_id Int      @id @default(autoincrement())
  pershkrimi  String?
  parfum      parfum[]
}

model klientet {
  id                Int       @id @default(autoincrement())
  emri              String
  mbiemri           String
  telefoni          String?
  email             String    @unique(map: "Klientet_email_key")
  data_lindjes      DateTime
  gjinia            String
  adresa            String
  data_regjistrimit DateTime  @default(now())
  piket_besnikerise Int       @default(0)
  user_id           Int?      @unique(map: "Klientet_user_id_key")
  users             users?    @relation(fields: [user_id], references: [id], map: "Klientet_user_id_fkey")
  reviews           reviews[]
  shitjet           shitjet[]
}

model markat {
  marka_id         Int      @id @default(autoincrement())
  emri             String   @unique(map: "Markat_emri_key")
  shteti_origjines String?
  website          String?
  pershkrimi       String?
  logoja           String?
  parfum           parfum[]
}

model mostrat {
  mostre_id  Int    @id @default(autoincrement())
  sasia_stok Int
  volumi_ml  Int
  statusi    String
  parfum_id  Int
  parfum     parfum @relation(fields: [parfum_id], references: [parfum_id], map: "Mostrat_parfum_id_fkey")

  @@index([parfum_id], map: "Mostrat_parfum_id_fkey")
}

model ofertat {
  oferte_id          Int                @id @default(autoincrement())
  emri               String
  pershkrimi         String?
  perqindja_zbritjes Float
  data_fillimit      DateTime
  data_perfundimit   DateTime
  statusi            String
  ofertat_parfumit   ofertat_parfumit[]
}

model ofertat_parfumit {
  id        Int     @id @default(autoincrement())
  oferte_id Int
  parfum_id Int
  ofertat   ofertat @relation(fields: [oferte_id], references: [oferte_id], map: "Ofertat_Parfumit_oferte_id_fkey")
  parfum    parfum  @relation(fields: [parfum_id], references: [parfum_id], map: "Ofertat_Parfumit_parfum_id_fkey")

  @@index([oferte_id], map: "Ofertat_Parfumit_oferte_id_fkey")
  @@index([parfum_id], map: "Ofertat_Parfumit_parfum_id_fkey")
}

model parfum {
  emri                        String
  cmimi                       Float
  pershkrimi                  String?
  gjinia_target               String
  kategoria_id                Int
  marka_id                    Int
  notat_ere                   String?
  parfum_id                   Int                           @id @default(autoincrement())
  sasia_stok                  Int                           @default(0)
  volumi_ml                   Int
  detajet_porosise_furnitorit detajet_porosise_furnitorit[]
  detajet_shitjes             detajet_shitjes[]
  mostrat                     mostrat[]
  ofertat_parfumit            ofertat_parfumit[]
  kategoria                   kategoria                     @relation(fields: [kategoria_id], references: [kategori_id], map: "Parfum_kategoria_id_fkey")
  markat                      markat                        @relation(fields: [marka_id], references: [marka_id], map: "Parfum_marka_id_fkey")
  reviews                     reviews[]

  @@index([kategoria_id], map: "Parfum_kategoria_id_fkey")
  @@index([marka_id], map: "Parfum_marka_id_fkey")

  wishlist wishlist[]
}

model porosite_furnitoreve {
  porosi_id                   Int                           @id @default(autoincrement())
  furnitor_id                 Int
  data_porosise               DateTime
  shuma_totale                Float
  statusi                     String
  data_pranimit               DateTime?
  detajet_porosise_furnitorit detajet_porosise_furnitorit[]
  furnitoret                  furnitoret                    @relation(fields: [furnitor_id], references: [furnitor_id], map: "Porosite_Furnitoreve_furnitor_id_fkey")

  @@index([furnitor_id], map: "Porosite_Furnitoreve_furnitor_id_fkey")
}

model punetoret {
  punetor_id     Int       @id @default(autoincrement())
  emri           String
  mbiemri        String
  pozita         String
  telefoni       String?
  email          String
  data_punesimit DateTime
  paga           Float
  shitjet        shitjet[]
}

model refreshtokens {
  id      Int      @id @default(autoincrement())
  user_id Int
  token   String
  expires DateTime
  created DateTime @default(now())
  revoked Boolean  @default(false)
  users   users    @relation(fields: [user_id], references: [id], map: "RefreshTokens_user_id_fkey")

  @@index([user_id], map: "RefreshTokens_user_id_fkey")
}

model reviews {
  review_id Int      @id @default(autoincrement())
  rating    Int
  komenti   String?  @db.Text
  data      DateTime @default(now())
  klient_id Int
  parfum_id Int
  klientet  klientet @relation(fields: [klient_id], references: [id], map: "Reviews_klient_id_fkey")
  parfum    parfum   @relation(fields: [parfum_id], references: [parfum_id], map: "Reviews_parfum_id_fkey")

  @@index([klient_id], map: "Reviews_klient_id_fkey")
  @@index([parfum_id], map: "Reviews_parfum_id_fkey")
}

model roles {
  id              Int         @id @default(autoincrement())
  emertimi        String      @unique(map: "Roles_emertimi_key")
  pershkrimi      String?
  normalized_name String?
  userroles       userroles[]
}

model shitjet {
  shitje_id       Int               @id @default(autoincrement())
  klient_id       Int
  punetor_id      Int
  data_shitjes    DateTime
  shuma_totale    Float
  zbritja         Float
  metoda_pageses  String
  detajet_shitjes detajet_shitjes[]
  klientet        klientet          @relation(fields: [klient_id], references: [id], map: "Shitjet_klient_id_fkey")
  punetoret       punetoret         @relation(fields: [punetor_id], references: [punetor_id], map: "Shitjet_punetor_id_fkey")

  @@index([klient_id], map: "Shitjet_klient_id_fkey")
  @@index([punetor_id], map: "Shitjet_punetor_id_fkey")
}

model userclaims {
  id          Int    @id @default(autoincrement())
  user_id     Int
  claim_type  String
  claim_value String
  users       users  @relation(fields: [user_id], references: [id], map: "UserClaims_user_id_fkey")

  @@index([user_id], map: "UserClaims_user_id_fkey")
}

model userroles {
  id      Int   @id @default(autoincrement())
  user_id Int
  role_id Int
  roles   roles @relation(fields: [role_id], references: [id], map: "UserRoles_role_id_fkey")
  users   users @relation(fields: [user_id], references: [id], map: "UserRoles_user_id_fkey")

  @@index([role_id], map: "UserRoles_role_id_fkey")
  @@index([user_id], map: "UserRoles_user_id_fkey")
}

model users {
  id                  Int             @id @default(autoincrement())
  emri                String
  mbiemri             String
  email               String          @unique(map: "Users_email_key")
  password_hash       String
  phone_number        String?
  email_confirmed     Boolean         @default(false)
  lockout_enabled     Boolean         @default(true)
  access_failed_count Int             @default(0)
  data_krijimit       DateTime        @default(now())
  statusi             String          @default("Active")
  auditlogs           auditlogs[]
  klientet            klientet?
  refreshtokens       refreshtokens[]
  userclaims          userclaims[]
  userroles           userroles[]
  usertokens          usertokens[]
  wishlist            wishlist[]
}

model usertokens {
  id             Int    @id @default(autoincrement())
  user_id        Int
  login_provider String
  token_name     String
  token_value    String
  users          users  @relation(fields: [user_id], references: [id], map: "UserTokens_user_id_fkey")

  @@index([user_id], map: "UserTokens_user_id_fkey")
}

model wishlist {
  wishlist_id  Int      @id @default(autoincrement())
  data_shtimit DateTime @default(now())
  parfum_id    Int
  user_id      Int
  parfum parfum @relation(fields: [parfum_id], references: [parfum_id], map: "Wishlist_parfum_fkey")
  users        users    @relation(fields: [user_id], references: [id], map: "Wishlist_user_id_fkey")

  @@unique([user_id, parfum_id], map: "Wishlist_user_id_parfum_id_key")
  @@index([parfum_id], map: "Wishlist_parfum_fkey")
}
